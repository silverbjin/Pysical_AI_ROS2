#!/usr/bin/env python3
import numpy as np

class TrajectoryGenerator:
    """
    4족 보행 로봇의 발끝(End-Effector) 궤적을 생성하는 클래스.
    Cycloid 기반의 스윙 궤적과 안정적인 Raibert Heuristic 기반 대칭 스탠스 궤적을 제공한다.
    """
    def __init__(self, step_height: float = 0.05) -> None:
        # 발을 들어 올릴 목표 클리어런스 높이 (m)
        self.step_height: float = step_height 
 
    def generate_swing(self, start_pos: np.ndarray, end_pos: np.ndarray, swing_phase: float) -> np.ndarray:
        """
        스윙(유각기) 단계의 3차원 발끝 목표 좌표를 계산한다.
        
        Args:
            start_pos (np.ndarray): [x, y, z] 스윙이 시작된 이전 접지 위치
            end_pos (np.ndarray): [x, y, z] 스윙이 끝날 목표 착지 위치
            swing_phase (float): 0.0 ~ 1.0 사이로 정규화된 스윙 진행률 (s)
        Returns:
            np.ndarray: [x, y, z] 현재 타임스텝의 힙 좌표계 기준 목표 위치
        """
        # 진행률 s의 범위를 안전하게 클램핑 (수치 예외 방지)
        s = np.clip(swing_phase, 0.0, 1.0)
 
        # 1. 수평 이동 (X, Y축): 완벽한 이착륙 속도 0을 보장하는 사이클로이드 보간
        s_prime = s - (1.0 / (2.0 * np.pi)) * np.sin(2.0 * np.pi * s)
        
        current_x = (1.0 - s_prime) * start_pos[0] + s_prime * end_pos[0]
        current_y = (1.0 - s_prime) * start_pos[1] + s_prime * end_pos[1]
 
        # 2. 수직 이동 (Z축): 지면 높이 보간 및 가감속 충격 완화 곡선 적용
        base_z = (1.0 - s_prime) * start_pos[2] + s_prime * end_pos[2]
        
        # [교재 표준 채택]: 수직 사이클로이드 매핑 (0.0 -> max_height -> 0.0)
        # s가 0.5 미만일 때 상승, 0.5 이상일 때 하강하는 완벽히 매끄러운 곡선 구현
        if s < 0.5:
            # 상승 구간 (0.0 ~ 0.5) -> 정규화 진행률 연산을 통해 부드럽게 가속
            z_phase = 2.0 * s
            z_prime = z_phase - (1.0 / (2.0 * np.pi)) * np.sin(2.0 * np.pi * z_phase)
            height_offset = self.step_height * z_prime
        else:
            # 하강 구간 (0.5 ~ 1.0) -> 지면 터치다운 충격 극소화
            z_phase = 2.0 * (1.0 - s)
            z_prime = z_phase - (1.0 / (2.0 * np.pi)) * np.sin(2.0 * np.pi * z_phase)
            height_offset = self.step_height * z_prime
 
        current_z = base_z + height_offset
 
        return np.array([current_x, current_y, current_z])
 
    def generate_stance(self, nominal_pos: np.ndarray, velocity_cmd: np.ndarray, 
                        stance_phase: float, T_cycle: float, duty_factor: float) -> np.ndarray:
        """
        [Drift 방지 리팩토링] 스탠스(입각기) 단계의 발끝 좌표를 계산한다.
        - 이전 위치에 누적하는 방식이 아닌, 위상(Phase)에 따른 절대적 중심선 기반 선형 트래킹 기법 적용.
        
        Args:
            nominal_pos (np.ndarray): [x, y, z] 해당 다리의 기준 기립 원점 좌표
            velocity_cmd (np.ndarray): [vx, vy, 0] 로봇 몸체 기준 목표 속도 벡터
            stance_phase (float): 0.0 ~ 1.0 사이로 정규화된 스탠스 진행률
            T_cycle (float): 전체 보행 주기 (sec)
            duty_factor (float): 듀티 팩터 (Trot의 경우 0.5)
        Returns:
            np.ndarray: [x, y, z] 업데이트된 스탠스 발끝 좌표
        """
        s = np.clip(stance_phase, 0.0, 1.0)
        
        # 전체 스탠스 시간 계산 (T_stance = T_cycle * Duty_Factor)
        T_stance = T_cycle * duty_factor
        
        # 발끝이 몸체 중심 진행 반대 방향으로 이동해야 하는 총 스트로크 거리 (Stroke)
        stroke = velocity_cmd * T_stance
        
        # 스탠스 위상 s가 0.0(착지)일 때 +stroke/2 에서 시작하여, 1.0(이륙)일 때 -stroke/2 로 선형 이동
        # P_stance = P_nominal + (0.5 - s) * stroke
        next_pos = nominal_pos + (0.5 - s) * stroke
        
        # Z축 지면 유지 (9장 오프셋 레거시 유지)
        next_pos[2] = nominal_pos[2]
        
        return next_pos
    
    # 10.3.6 목표 착지점(Foothold) 계산
    def calculate_foothold(self, nominal_hip_pos: np.ndarray, velocity_cmd: np.ndarray, 
                            stance_duration: float, current_velocity: np.ndarray = None, 
                            k_v: float = 0.0) -> np.ndarray:
        """
        [Raibert Heuristic] 현재 속도 명령과 물리 주기를 바탕으로 목표 착지점(Foothold)을 계산한다.
        
        Args:
            nominal_hip_pos (np.ndarray): [x, y, z] 해당 다리의 기준 기립 원점 좌표 (Body Frame 기준)
            velocity_cmd (np.ndarray): [vx, vy, 0] 사용자가 입력한 로봇의 목표 선속도 벡터
            stance_duration (float): 스탠스 유지 시간 (T_cycle * duty_factor)
            current_velocity (np.ndarray, Optional): 오도메트리 등에서 계측된 실제 로봇의 현재 선속도
            k_v (float, Optional): 속도 오차 보정을 위한 피드백 게인 (기본값 0.0)
            
        Returns:
            np.ndarray: [x, y, z] Body Frame 기준의 3차원 목표 착지점 위치
        """
        # 1. 첫 번째 항: 피드포워드 중립 위치 (Neutral Point) 오프셋 연산
        # 스탠스 구간 동안 이동할 총 스트로크 거리의 절반(0.5)만큼 전진 배치
        feedforward_offset = velocity_cmd * stance_duration * 0.5
        
        # 2. 두 번째 항: 속도 오차 비례 피드백 (Feedback) 오프셋 연산
        feedback_offset = np.zeros(3)
        if current_velocity is not None and k_v > 0.0:
            # (실제 속도 - 목표 속도)에 비례하여 착지점을 밀거나 당김
            velocity_error = current_velocity - velocity_cmd
            feedback_offset = k_v * velocity_error
            feedback_offset[2] = 0.0 # Z축 오차 보정은 배제
            
        # 3. 최종 목표 착지점 매핑 (기본 힙 좌표 기준 위치 + 피드포워드 + 피드백)
        target_x = nominal_hip_pos[0] + feedforward_offset[0] + feedback_offset[0]
        target_y = nominal_hip_pos[1] + feedforward_offset[1] + feedback_offset[1]
        
        # Z축은 10.1절의 시스템 제약조건인 nominal standing height(-0.3m)로 고정
        target_z = nominal_hip_pos[2] 
        
        return np.array([target_x, target_y, target_z])