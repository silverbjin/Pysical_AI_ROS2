<?xml version="1.0"?>
<sdf version="1.10">
  <world name="force_semantics">
    <gravity>0 0 0</gravity>
    <physics name="fixed_2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine><filename>gz-physics-dartsim-plugin</filename></engine>
    </plugin>
    <model name="known_inertia">
      <link name="rotor">
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia>
        </inertial>
      </link>
      <joint name="drive" type="revolute">
        <parent>world</parent><child>rotor</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-100</lower><upper>0</upper><effort>10</effort><velocity>100</velocity></limit>
          <dynamics><damping>0.0</damping><friction>0</friction></dynamics>
        </axis>
      </joint>
    </model>
  </world>
</sdf>
