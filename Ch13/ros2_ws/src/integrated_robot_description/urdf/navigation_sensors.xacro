<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="navigation_sensors" params="backend">
    <xacro:if value="${backend == 'gazebo'}">
      <gazebo reference="base_link">
        <sensor name="navigation_imu" type="imu">
          <always_on>true</always_on><update_rate>50</update_rate>
          <topic>/navigation/imu</topic><gz_frame_id>base_link</gz_frame_id>
          <imu><enable_orientation>false</enable_orientation></imu>
        </sensor>
      </gazebo>
      <gazebo reference="lidar_link">
        <sensor name="navigation_lidar" type="gpu_lidar">
          <always_on>true</always_on><update_rate>10</update_rate>
          <topic>/navigation/scan</topic><gz_frame_id>lidar_link</gz_frame_id>
          <lidar>
            <scan><horizontal><samples>360</samples><resolution>1</resolution>
              <min_angle>${-pi}</min_angle><max_angle>${pi-2*pi/360}</max_angle>
            </horizontal></scan>
            <range><min>0.05</min><max>10</max><resolution>0.001</resolution></range>
            <visibility_mask>1</visibility_mask>
          </lidar>
        </sensor>
      </gazebo>
      <gazebo>
        <plugin filename="navigation_gazebo_observer" name="integrated_robot_navigation_sensors::GazeboObserver"/>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
