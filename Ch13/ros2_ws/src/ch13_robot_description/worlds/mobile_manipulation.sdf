<?xml version="1.0"?>
<sdf version="1.9"><world name="ch13">
<physics name="physics" type="ignored"><max_step_size>0.002</max_step_size><real_time_factor>1</real_time_factor></physics>
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/><plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
<plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
<plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
<light name="sun" type="directional"><pose>0 0 5 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.3 0.1 -1</direction></light>
<model name="ground"><static>true</static><link name="ground_link"><collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision><visual name="ground_visual"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></visual></link></model>
<model name="fixture"><static>true</static><pose>0.38 0 0.23 0 0 0</pose><link name="fixture_link"><collision name="fixture_collision"><geometry><box><size>0.14 0.18 0.46</size></box></geometry></collision><visual name="fixture_visual"><geometry><box><size>0.14 0.18 0.46</size></box></geometry></visual></link></model>
<model name="cube"><pose>0.38 0 0.478 0 0 0</pose><link name="cube_link">
<inertial><mass>0.025</mass><inertia><ixx>0.0000054</ixx><iyy>0.0000054</iyy><izz>0.0000054</izz></inertia></inertial>
<collision name="cube_collision"><geometry><box><size>0.036 0.036 0.036</size></box></geometry><surface><friction><ode><mu>2</mu><mu2>2</mu2></ode></friction></surface></collision>
<visual name="cube_visual"><geometry><box><size>0.036 0.036 0.036</size></box></geometry><material><diffuse>0.9 0.1 0.1 1</diffuse></material></visual>
<sensor name="cube_contact" type="contact"><always_on>true</always_on><update_rate>100</update_rate><topic>/ch13/cube_contacts</topic><contact><collision>cube_collision</collision></contact></sensor>
</link><plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose><publish_nested_model_pose>true</publish_nested_model_pose><use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>50</update_frequency></plugin></model>
</world></sdf>
