Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 245; 247; 250
    Fixed Frame: map
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Map
    Name: SLAM occupancy grid
    Enabled: true
    Alpha: 0.8
    Draw Behind: true
    Topic:
      Value: /map
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Grid
    Name: Floor grid (0.5 m)
    Enabled: true
    Cell Size: 0.5
    Plane Cell Count: 20
    Color: 180; 190; 200
    Alpha: 0.4
  - Class: rviz_default_plugins/RobotModel
    Name: Quadruped
    Enabled: true
    Alpha: 0.85
    Visual Enabled: true
    Collision Enabled: false
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/LaserScan
    Name: Height-filtered 3D projection
    Enabled: true
    Topic:
      Value: /scan/projected
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Color Transformer: FlatColor
    Position Transformer: XYZ
    Color: 230; 25; 25
    Alpha: 1
    Style: Spheres
    Size (m): 0.035
    Size (Pixels): 4
    Decay Time: 0
    Queue Size: 10
    Use Fixed Frame: true
  - Class: rviz_default_plugins/Pose
    Name: IMU measured orientation (XYZ)
    Enabled: true
    Topic:
      Value: /figure_11_2/imu_pose
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Shape: Axes
    Axes Length: 0.45
    Axes Radius: 0.018
  - Class: rviz_default_plugins/TF
    Name: TF debug (off for publication)
    Enabled: false
    Show Names: true
    Show Axes: true
    Show Arrows: false
  - Class: rviz_default_plugins/PointCloud2
    Name: Raw 3D cloud (enable to inspect floor)
    Enabled: false
    Topic:
      Value: /lidar/points
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 2
    Style: Points
    Size (Pixels): 2
    Color Transformer: AxisColor
    Axis: Z
    Position Transformer: XYZ
    Decay Time: 0
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Oblique sensor view
      Target Frame: map
      Distance: 11.0
      Pitch: 1.4
      Yaw: 0.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0.25
      Near Clip Distance: 0.01
Window Geometry:
  Width: 1200
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
