<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>

    <!-- <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin> -->

  </gazebo>

  <!-- Gazebo Harmonic IMU 센서 및 플러그인 설정 -->
  <gazebo reference="base_link">
    <sensor name="imu_sensor" type="imu">
      <!-- 1. 센서가 항상 활성화되도록 설정하고 데이터 발행 주기(Hz) 지정 (사족보행은 최소 100Hz 이상 추천) -->
      <!-- <always_on>true</always_on> -->
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <!-- <visualize>true</visualize> -->
      <topic>/model/my_quadruped/sensor/imu</topic>
      <!-- <topic>/imu</topic> -->
      
      <!-- 2. 현실적인 센서 노이즈 추가 (가속도계 및 자이로스코프 백색 소음 세팅) -->
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
        </linear_acceleration>
      </imu>

      <!-- 3. Gazebo Harmonic 전용 센서 관리 시스템 플러그인 로드 -->
      <!-- <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin> -->
    </sensor>
  </gazebo>

  <!-- Gazebo Harmonic 2D LiDAR 센서 및 물리적 링크 맵핑 설정 -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
    <!-- <sensor name="gpu_lidar" type="gpu_lidar"> -->
    <!-- <sensor name="cpu_lidar" type="lidar"> -->
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10.0</update_rate>      
      <!-- Gazebo에서 출력할 전용 센서 토픽명 지정 (명시하지 않으면 무작위 경로로 생성됨) -->
      <topic>/model/my_quadruped/scan</topic>
      <!-- <topic>/scan</topic> -->      
      <!-- Gazebo 공식 SDF 표준 규격 태그<frame_id>: 가제보가 토픽을 발행할 때 심을 frame_id 지정 -->      
      <gz_frame_id>lidar_link</gz_frame_id>
      
      <ray>
        <scan>
          <horizontal>
            <!-- 360도 전방위를 1도 간격으로 촘촘하게 분할하여 총 360개의 샘플 데이터 획득 -->
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.1415926</min_angle> <!-- -180도 (후방) -->
            <max_angle>3.1415926</max_angle>  <!-- +180도 (후방) -->
          </horizontal>
        </scan>
        <range>
          <!-- 사족 보행 로봇 동체에 레이저가 걸리는 것을 방지하기 위해 최소 반경을 10cm로 제한 -->
          <min>0.10</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      
      <!-- [중요] Gazebo Harmonic 표준 센서 매니저 시스템 플러그인 연동 -->
      <!-- <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin> -->
    </sensor>
  </gazebo>

</robot>