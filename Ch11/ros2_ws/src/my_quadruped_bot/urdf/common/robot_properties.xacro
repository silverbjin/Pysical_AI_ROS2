<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="base_length" value="0.60" /> 
  <xacro:property name="base_width"  value="0.30" /> 
  <xacro:property name="base_height" value="0.15" /> 
  <xacro:property name="base_mass"   value="6.0" />  <!-- default 6.0 kg -->
  <xacro:property name="hip_offset_x" value="0.25" /> 
  <xacro:property name="hip_offset_y" value="0.10" /> 
  <xacro:property name="hip_offset_z" value="0.00" /> 
  <xacro:property name="hip_length"   value="0.08" />  
  <xacro:property name="hip_mass"     value="0.20" /> 
  <xacro:property name="thigh_length" value="0.25" />
  <xacro:property name="thigh_mass"   value="0.70" /> 
  <xacro:property name="calf_length"  value="0.25" />
  <xacro:property name="calf_mass"    value="0.50" /> 
  <xacro:property name="hip_min" value="-0.8" />
  <xacro:property name="hip_max" value="0.8" />
  <xacro:property name="thigh_min" value="-1.0" />
  <xacro:property name="thigh_max" value="4.0" />
  
