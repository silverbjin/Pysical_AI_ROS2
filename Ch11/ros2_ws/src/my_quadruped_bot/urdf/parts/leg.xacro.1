<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="leg" params="prefix x_reflect y_reflect">

    <joint name="${prefix}_hip_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_hip_link"/>
      <origin xyz="${x_reflect * hip_offset_x} ${y_reflect * hip_offset_y} ${hip_offset_z}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/> <limit lower="${hip_min}" upper="${hip_max}" effort="20" velocity="10"/>
    </joint>

    <link name="${prefix}_hip_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="${hip_length} 0.04 0.04"/></geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="${hip_length} 0.04 0.04"/></geometry>
      </collision>
      <xacro:box_inertia m="${hip_mass}" x="${hip_length}" y="0.04" z="0.04"/>
    </link>

    <joint name="${prefix}_thigh_joint" type="revolute">
      <parent link="${prefix}_hip_link"/>
      <child link="${prefix}_thigh_link"/>
      <origin xyz="0 ${y_reflect * 0.05} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/> <limit lower="${thigh_min}" upper="${thigh_max}" effort="30" velocity="10"/>
    </joint>

    <link name="${prefix}_thigh_link">
      <visual>
        <origin xyz="0 0 ${-thigh_length/2}" rpy="0 0 0"/>
        <geometry><cylinder length="${thigh_length}" radius="0.02"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-thigh_length/2}" rpy="0 0 0"/>
        <geometry><cylinder length="${thigh_length}" radius="0.02"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${-thigh_length/2}" rpy="0 0 0"/>
        <mass value="${thigh_mass}"/>
        <inertia ixx="${(1.0/12.0) * thigh_mass * (3*0.02*0.02 + thigh_length*thigh_length)}" ixy="0.0" ixz="0.0"
                 iyy="${(1.0/12.0) * thigh_mass * (3*0.02*0.02 + thigh_length*thigh_length)}" iyz="0.0"
                 izz="${0.5 * thigh_mass * 0.02 * 0.02}"/>
      </inertial>
    </link>

    <joint name="${prefix}_calf_joint" type="revolute">
      <parent link="${prefix}_thigh_link"/>
      <child link="${prefix}_calf_link"/>
      <origin xyz="0 0 ${-thigh_length}" rpy="0 0 0"/> 
      <axis xyz="0 1 0"/> <limit lower="-2.8" upper="2.8" effort="30" velocity="10"/>
    </joint>

    <link name="${prefix}_calf_link">
      <visual>
        <origin xyz="0 0 ${-calf_length/2}" rpy="0 0 0"/>
        <geometry><cylinder length="${calf_length}" radius="0.015"/></geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-calf_length/2}" rpy="0 0 0"/>
        <geometry><cylinder length="${calf_length}" radius="0.015"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${-calf_length/2}" rpy="0 0 0"/>
        <mass value="${calf_mass}"/>
        <inertia ixx="${(1.0/12.0) * calf_mass * (3*0.015*0.015 + calf_length*calf_length)}" ixy="0.0" ixz="0.0"
                 iyy="${(1.0/12.0) * calf_mass * (3*0.015*0.015 + calf_length*calf_length)}" iyz="0.0"
                 izz="${0.5 * calf_mass * 0.015 * 0.015}"/>
      </inertial>
    </link>
    
    <joint name="${prefix}_foot_fixed" type="fixed">
        <parent link="${prefix}_calf_link"/>
        <child link="${prefix}_foot"/>
        <origin xyz="0 0 ${-calf_length}" rpy="0 0 0"/>
    </joint>
    
    <link name="${prefix}_foot">
      <visual> 
        <geometry><sphere radius="0.02"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><sphere radius="0.02"/></geometry>
      </collision>
      <inertial>
        <mass value="0.10"/>
        <inertia ixx="${(2.0/5.0) * 0.10 * 0.02 * 0.02}" ixy="0.0" ixz="0.0"
                 iyy="${(2.0/5.0) * 0.10 * 0.02 * 0.02}" iyz="0.0"
                 izz="${(2.0/5.0) * 0.10 * 0.02 * 0.02}"/>
      </inertial>
    </link>

  </xacro:macro>
</robot>