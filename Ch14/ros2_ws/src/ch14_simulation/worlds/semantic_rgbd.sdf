<?xml version="1.0"?>
<sdf version="1.9">
  <world name="ch14_semantic">
    <physics name="sim" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <scene><ambient>0.8 0.8 0.8 1</ambient><background>0.12 0.12 0.12 1</background><shadows>false</shadows></scene>
    <light type="directional" name="key"><pose>0 0 5 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.1 0.1 0.1 1</specular><direction>1 0 -1</direction><cast_shadows>false</cast_shadows></light>
    <!-- Isolated static real 3D mesh. No ground/backdrop geometry: depth silhouette is independent GT. -->
    <include><uri>model://person_standing</uri><name>semantic_person</name><pose>2.5 0 0 0 0 0</pose><static>true</static></include>
    <model name="rgbd_rig"><static>true</static><pose>0 0 1 0 0 0</pose><link name="camera_link">
      <sensor name="rgbd" type="rgbd_camera">
        <always_on>true</always_on><update_rate>10</update_rate><topic>/ch14/rgbd</topic><gz_frame_id>camera_optical</gz_frame_id>
        <camera><horizontal_fov>1.2</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>5.0</far></clip></camera>
      </sensor>
    </link></model>
  </world>
</sdf>
