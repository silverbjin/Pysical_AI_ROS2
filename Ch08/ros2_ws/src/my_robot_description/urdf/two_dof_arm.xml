<mujoco model="hello_world">
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3" 
             rgb2=".2 .3 .4" width="300" height="300" mark="edge" markrgb=".8 .8 .8"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 .05" type="plane" material="grid" condim="3"/>
    
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>

    <body name="ball" pos="0 0 1.0">
      <freejoint/>
      <geom name="red_sphere" size=".1" rgba="1 0 0 1" type="sphere"/>
    </body>

    <body name="link1" pos="0 0 0.5">
      <joint name="shoulder" type="hinge" axis="0 1 0" range="-90 90"/>
      <geom type="capsule" fromto="0 0 0  0 0 0.5" size="0.05"/>
      
      <body name="link2" pos="0 0 0.5">
        <joint name="elbow" type="hinge" axis="0 1 0" range="-120 120"/>
        <geom type="capsule" fromto="0 0 0  0 0 0.5" size="0.04"/>
      </body>
    </body>

  </worldbody>

  <actuator>
    <motor name="motor_shoulder" joint="shoulder" ctrlrange="-1 1" gear="50"/>
    <motor name="motor_elbow" joint="elbow" ctrlrange="-1 1" gear="30"/>
  </actuator>

</mujoco>
