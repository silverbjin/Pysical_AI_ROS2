<?xml version="1.0"?>
<!-- Z(Yaw) - Y(Pitch) - Y(Pitch) - X(Roll) - Y(Pitch) - Z(Yaw) -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

  <xacro:property name="base_radius" value="0.1"/>
  <xacro:property name="base_height" value="0.1"/>
  <xacro:property name="link_len" value="0.5"/>
  <xacro:property name="link_width" value="0.05"/>
  <xacro:property name="link_mass" value="1.0"/>

  <xacro:macro name="box_inertia" params="m w h d com_x com_y com_z">
    <inertial>
      <origin xyz="${com_x} ${com_y} ${com_z}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (h*h + d*d)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12) * (w*w + d*d)}" iyz="0.0"
               izz="${(m/12) * (w*w + h*h)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h com_x com_y com_z">
    <inertial>
      <origin xyz="${com_x} ${com_y} ${com_z}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12) * (3*r*r + h*h)}" iyz="0.0"
               izz="${(m/2) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="arm_link_macro" params="name color_name r g b">
    <link name="${name}">
      <visual>
        <geometry>
          <box size="${link_width} ${link_width} ${link_len}"/>
        </geometry>
        <origin xyz="0 0 ${link_len/2}" rpy="0 0 0"/>
        <material name="${color_name}">
          <color rgba="${r} ${g} ${b} 1"/>
        </material>
      </visual>
      <collision name="${name}_collision">
        <geometry>
          <box size="${link_width} ${link_width} ${link_len}"/>
        </geometry>
        <origin xyz="0 0 ${link_len/2}" rpy="0 0 0"/>
      </collision>
      <xacro:box_inertia m="${link_mass}" w="${link_width}" h="${link_len}" d="${link_width}" com_x="0" com_y="0" com_z="${link_len/2}"/>
    </link>
  </xacro:macro>

  <!-- <link name="world"/>
  
  <joint name="world_to_base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint> -->

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="${base_height}" radius="${base_radius}"/>
      </geometry>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <material name="gray"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <collision name="base_link_collision">
      <geometry><cylinder length="${base_height}" radius="${base_radius}"/></geometry>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
    </collision>
    <xacro:cylinder_inertia m="10.0" r="${base_radius}" h="${base_height}" com_x="0" com_y="0" com_z="${base_height/2}"/>
  </link>

  <!-- link 1 -->
  <xacro:arm_link_macro name="link1" color_name="orange" r="1" g="0.6" b="0"/>
  <!-- joint1 : Z (Base Yaw) -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/> <limit lower="-3.14159" upper="3.14159" effort="100" velocity="1.0"/>
  </joint>

  <!-- link 2 -->
  <xacro:arm_link_macro name="link2" color_name="yellow" r="1" g="1" b="0"/>
  <!-- joint2 : Y (Shoulder Pitch) -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 ${link_len}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> <limit lower="-1.57079" upper="1.57079" effort="100" velocity="1.0"/>
  </joint>

  <!-- link 3 -->
  <xacro:arm_link_macro name="link3" color_name="green" r="0" g="0.8" b="0.2"/>
  <!-- joint3 : Y (Elbow Pitch) -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 ${link_len}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> <limit lower="-2.0944" upper="2.0944" effort="100" velocity="1.5"/>
  </joint>

  <!-- link 4 -->
  <xacro:arm_link_macro name="link4" color_name="blue" r="0" g="0.4" b="1"/>
  <!-- joint4 : X (Wrist Roll) -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 ${link_len}" rpy="0 0 0"/>
    <axis xyz="1 0 0"/> <limit lower="-3.14159" upper="3.14159" effort="100" velocity="2.0"/>
  </joint>


  <!-- link 5 -->  
  <link name="link_wrist_pitch">
    <visual>
      <geometry><cylinder radius="0.04" length="0.06"/></geometry>
      <material name="cyan"><color rgba="0 1 1 1"/></material>
      <origin xyz="0 0 0.04" rpy="1.5708 0 0"/>
    </visual>
    <collision name="wrist_pitch_collision">
      <geometry><cylinder radius="0.04" length="0.06"/></geometry>
      <origin xyz="0 0 0.04" rpy="1.5708 0 0"/>
    </collision>
    <!-- <xacro:cylinder_inertia m="0.3" r="0.04" h="0.06"/> -->
    <xacro:cylinder_inertia m="0.3" r="0.04" h="0.06" com_x="0" com_y="0" com_z="0.04"/>
  </link>
  <!-- joint5 : Y (Wrist Pitch) -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link_wrist_pitch"/>
    <origin xyz="0 0 ${link_len}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="50" velocity="2.5"/>
  </joint>

  <!-- link 6 -->
  <link name="link_wrist_yaw">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="purple"><color rgba="0.8 0 0.8 1"/></material>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
    </visual>
    <collision name="wrist_yaw_collision">
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
    </collision>
    <!-- <xacro:cylinder_inertia m="0.2" r="0.035" h="0.04"/> -->
    <xacro:cylinder_inertia m="0.2" r="0.035" h="0.04" com_x="0" com_y="0" com_z="0.02"/>
  </link>
  <!-- joint6 : Z (Wrist Yaw) -->
  <joint name="joint6" type="revolute">
    <parent link="link_wrist_pitch"/>
    <child link="link_wrist_yaw"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="50" velocity="3.0"/>
  </joint>

  <!-- TCP -->
  <link name="tool0">
    <visual>
      <geometry><sphere radius="0.01"/></geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
    <!-- <collision name="tool0_collision">
      <geometry><sphere radius="0.01"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial> -->
  </link>
  <joint name="tool0_fixed" type="fixed">
    <parent link="link_wrist_yaw"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>

  <!-- Gripper Base -->
  <link name="gripper_base">
    <visual>
      <geometry><box size="0.06 0.04 0.04"/></geometry>
      <material name="dark_gray"><color rgba="0.3 0.3 0.3 1"/></material>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
    </visual>
    <collision name="gripper_base_collision">
      <geometry><box size="0.06 0.04 0.04"/></geometry>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
    </collision>
    <!-- <xacro:box_inertia m="0.1" w="0.06" h="0.04" d="0.04"/> -->
    <xacro:box_inertia m="0.1" w="0.06" h="0.04" d="0.04" com_x="0" com_y="0" com_z="0.02"/>
  </link>  
  <joint name="gripper_base_fixed" type="fixed">
    <parent link="tool0"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Finger1 -->
  <link name="finger1">
    <visual>
      <geometry><box size="0.015 0.03 0.08"/></geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <material name="white"><color rgba="1 1 1 1"/></material>
    </visual>
    <collision name="finger1_collision">
      <geometry><box size="0.015 0.03 0.08"/></geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </collision>
    <!-- <xacro:box_inertia m="0.05" w="0.015" h="0.03" d="0.08"/> -->
    <xacro:box_inertia m="0.05" w="0.015" h="0.03" d="0.08" com_x="0" com_y="0" com_z="0.04"/>
  </link>
  <joint name="joint_finger1" type="prismatic">
    <parent link="gripper_base"/>
    <child link="finger1"/>
    <origin xyz="-0.03 0 0.04" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.025" effort="20" velocity="0.2"/>
  </joint>

  <!-- Finger2 -->
  <link name="finger2">
    <visual>
      <geometry><box size="0.015 0.03 0.08"/></geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <material name="white"/>
    </visual>
    <collision name="finger2_collision">
      <geometry><box size="0.015 0.03 0.08"/></geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </collision>
    <!-- <xacro:box_inertia m="0.05" w="0.015" h="0.03" d="0.08"/> -->
    <xacro:box_inertia m="0.05" w="0.015" h="0.03" d="0.08" com_x="0" com_y="0" com_z="0.04"/>
  </link>
  <joint name="joint_finger2" type="prismatic">
    <parent link="gripper_base"/>
    <child link="finger2"/>
    <origin xyz="0.03 0 0.04" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0.0" upper="0.025" effort="20" velocity="0.2"/>
  </joint>

</robot>