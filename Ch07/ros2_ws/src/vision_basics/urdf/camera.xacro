<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Educational RGB-D camera fixed to the base. Optical X right, Y down, Z forward. -->
  <link name="camera_link">
    <visual><geometry><box size="0.06 0.06 0.04"/></geometry></visual>
    <collision><geometry><box size="0.06 0.06 0.04"/></geometry></collision>
    <inertial><mass value="0.05"/>
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00003"/>
    </inertial>
  </link>
  <joint name="base_to_camera" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="0.16 0 0.25" rpy="0 0 0"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>
  <gazebo reference="camera_link">
    <sensor name="front_rgbd" type="rgbd_camera">
      <always_on>true</always_on><update_rate>30</update_rate>
      <topic>/camera</topic>
      <camera>
        <horizontal_fov>1.04719755</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>5.0</far></clip>
        <depth_camera><clip><near>0.1</near><far>5.0</far></clip></depth_camera>
      </camera>
    </sensor>
  </gazebo>
</robot>
