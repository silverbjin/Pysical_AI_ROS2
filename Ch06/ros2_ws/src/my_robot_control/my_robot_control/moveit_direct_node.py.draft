#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from rclpy.parameter import Parameter  # 💡 Parameter 객체 임포트 추가
from moveit_configs_utils import MoveItConfigsBuilder
# from moveit_py.main import MoveItPy
# 💡 Jazzy 핵심 변경점: moveit_py가 아니라 moveit 패키지에서 가져옵니다.
from moveit.planning import MoveItPy

# 💡 중첩된 딕셔너리를 ROS 2 파라미터 표준 형식(점 표기법 프리픽스)으로 평탄화하는 함수
def flatten_dict(d, prefix=''):
    items = []
    for k, v in d.items():
        new_key = f"{prefix}{k}" if prefix else k
        if isinstance(v, dict):
            items.extend(flatten_dict(v, prefix=new_key + '.'))
        else:
            items.append((new_key, v))
    return items

class MoveItDirectNode(Node):
    def __init__(self):
        # 1. 원격 설정 패키지로부터 MoveItConfigs 빌드
        moveit_config = (
            MoveItConfigsBuilder("my_robot", package_name="my_robot_moveit_config")
            .robot_description(file_path="config/my_robot.urdf.xacro")
            .trajectory_execution(file_path="config/moveit_controllers.yaml")
            .planning_pipelines(pipelines=["ompl"])
            .to_moveit_configs()
        )
        
        # # 💡 핵심 수정: 딕셔너리를 rclpy가 인식할 수 있는 Parameter 객체 리스트로 변환
        # param_overrides = [
        #     Parameter(name, value=value) 
        #     for name, value in moveit_config.to_dict().items()
        # ]
        # 💡 핵심 수정: 딕셔너리 내부의 중첩 구조를 일렬로 평탄화 처리
        flattened_params = flatten_dict(moveit_config.to_dict())

        # 평탄화된 튜플 리스트를 rclpy Parameter 객체 배열로 변환
        param_overrides = [
            Parameter(name, value=value) 
            for name, value in flattened_params
        ]

        # 2. 파라미터 오버라이드 주입 및 자동 선언(Declare) 활성화
        super().__init__(
            "moveit_direct_node",
            parameter_overrides=param_overrides,
            automatically_declare_parameters_from_overrides=True, # 오버라이드 파라미터 자동 등록
            allow_undeclared_parameters=True                      # MoveItPy 내부 동적 선언 허용
        )        
        self.get_logger().info("=== [my_robot_control] MoveItConfigsBuilder 로드 완료 ===")
        
        # 3. Jazzy 표준: MoveItPy 인스턴스 생성 및 기획 그룹 지정
        # 이 객체가 내부적으로 주입된 파라미터들을 읽어 들입니다.
        self.moveit = MoveItPy(node=self)
        self.arm_group = self.moveit.get_planning_component("arm_group")

def main(args=None):
    rclpy.init(args=args)
    node = MoveItDirectNode()
    
    # 예시 명령: home 포즈로 이동 계획 및 실행
    try:
        node.get_logger().info("Jazzy MoveItPy 제어 노드가 가동되었습니다. 'home' 위치로 이동합니다...")
        
        # 정적 목표 포즈 설정
        node.arm_group.set_start_state_to_current_state()
        node.arm_group.set_goal_state(configuration_name="home")
        
        # 계획(Plan) 및 실행(Execute)
        plan_result = node.arm_group.plan()
        if plan_result:
            node.get_logger().info("경로 계획 성공! 실행합니다.")
            node.moveit.execute(plan_result.trajectory, blocking=True)
        else:
            node.get_logger().error("경로 계획에 실패했습니다.")
            
    except Exception as e:
        node.get_logger().error(f"제어 중 에러 발생: {e}")
        
    rclpy.spin(node)
    rclpy.shutdown()

if __name__ == "__main__":
    main()