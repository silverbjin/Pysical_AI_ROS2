# my_robot_planner/planner_node.py
import rclpy
from rclpy.node import Node
from moveit.planning import MoveItPy


class PlannerNode(Node):
    def __init__(self):
        super().__init__('my_robot_planner')

        self.declare_parameter('planning_group', 'arm')
        self.declare_parameter('goal_name', 'ready')

        self._moveit = MoveItPy(node_name='my_robot_planner_moveit')
        self._run_once()

    def _run_once(self):
        planning_group = self.get_parameter('planning_group').value
        goal_name = self.get_parameter('goal_name').value

        component = self._moveit.get_planning_component(planning_group)

        # 현재 상태를 시작점으로 사용
        component.set_start_state_to_current_state()

        # SRDF에 정의된 named target 사용
        component.set_goal_state(configuration_name=goal_name)

        self.get_logger().info(f'Planning for group={planning_group}, goal={goal_name}')
        plan_result = component.plan()

        if not plan_result:
            self.get_logger().error('Planning failed')
            return

        self.get_logger().info('Executing trajectory')
        trajectory = plan_result.trajectory
        self._moveit.execute(trajectory, controllers=[])


def main():
    rclpy.init()
    node = PlannerNode()
    node.destroy_node()
    rclpy.shutdown()