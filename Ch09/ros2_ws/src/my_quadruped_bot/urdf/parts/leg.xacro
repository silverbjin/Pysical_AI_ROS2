<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="leg" params="prefix x_reflect y_reflect">

    <joint name="${prefix}_hip_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_hip_link"/>
      <origin xyz="${x_reflect * hip_offset_x} ${y_reflect * hip_offset_y} ${hip_offset_z}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/> 
      <limit lower="${hip_min}" upper="${hip_max}" effort="20" velocity="10"/>
    </joint>

    <link name="${prefix}_hip_link">
      <visual>
        <origin xyz="0 ${y_reflect * hip_length / 2.0} 0" rpy="0 0 0"/>
        <geometry><box size="0.04 ${hip_length} 0.04"/></geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <origin xyz="0 ${y_reflect * hip_length / 2.0} 0" rpy="0 0 0"/>
        <geometry><box size="0.04 ${hip_length} 0.04"/></geometry>
      </collision>
      <!-- Hip is a lateral bar along +Y/-Y, not the body X axis. -->
      <xacro:box_inertia m="${hip_mass}" x="0.04" y="${hip_length}" z="0.04" xyz="0 ${y_reflect * hip_length / 2.0} 0" rpy="0 0 0"/>
    </link>

    <joint name="${prefix}_thigh_joint" type="revolute">
      <parent link="${prefix}_hip_link"/>
      <child link="${prefix}_thigh_link"/>
      <!-- <origin xyz="0 ${y_reflect * 0.05} 0" rpy="0 0 0"/> -->
      <origin xyz="0 ${y_reflect * 0.05} 0" rpy="0 1.2 0"/> <!-- defalt pose -->
      <axis xyz="0 1 0"/> 
      <limit lower="${thigh_min}" upper="${thigh_max}" effort="30" velocity="10"/>
    </joint>

    <link name="${prefix}_thigh_link">
      <visual>
        <origin xyz="0 0 ${-thigh_length/2}" rpy="0 0 0"/>
        <geometry><cylinder length="${thigh_length}" radius="0.02"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-thigh_length/2}" rpy="0 0 0"/>
        <geometry><cylinder length="${thigh_length}" radius="0.02"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${thigh_mass}" r="0.02" h="${thigh_length}" xyz="0 0 ${-thigh_length/2.0}" rpy="0 0 0"/>
    </link>

    <joint name="${prefix}_calf_joint" type="revolute">
      <parent link="${prefix}_thigh_link"/>
      <child link="${prefix}_calf_link"/>
      <!-- <origin xyz="0 0 ${-thigh_length}" rpy="0 0 0"/>  -->
      <origin xyz="0 0 ${-thigh_length}" rpy="0 -2.4 0"/>   <!-- defalt pose -->
      <axis xyz="0 1 0"/>
      <limit lower="-2.8" upper="2.8" effort="30" velocity="10"/>
    </joint>

    <link name="${prefix}_calf_link">
      <visual>
        <origin xyz="0 0 ${-calf_length/2}" rpy="0 0 0"/>
        <geometry><cylinder length="${calf_length}" radius="0.015"/></geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-calf_length/2}" rpy="0 0 0"/>
        <geometry><cylinder length="${calf_length}" radius="0.015"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${calf_mass}" r="0.015" h="${calf_length}" xyz="0 0 ${-calf_length/2.0}" rpy="0 0 0"/>
    </link>
    
    <joint name="${prefix}_foot_fixed" type="fixed">
        <parent link="${prefix}_calf_link"/>
        <child link="${prefix}_foot"/>
        <origin xyz="0 0 ${-calf_length}" rpy="0 0 0"/>
    </joint>
    
    <link name="${prefix}_foot">
      <visual> 
        <geometry><sphere radius="0.02"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
      <!-- <collision name="${prefix}_foot_collision"> -->
        <geometry><sphere radius="0.02"/></geometry>
      </collision>
      <xacro:sphere_inertia m="0.10" r="0.02" xyz="0 0 0" rpy="0 0 0"/>
    </link>

    <!-- <gazebo reference="${prefix}_foot"> -->
      <!-- <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>1.0</mu2>
          </ode>
        </friction>
        <contact>
          <ode>
            <kp>1000000.0</kp>
            <kd>100.0</kd>
          </ode>
        </contact>
      </surface> -->
      <!-- <visual>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
          <specular>0.5 0.5 0.5 1.0</specular>
        </material>
      </visual>
    </gazebo> -->

    <!-- <gazebo reference="${prefix}_foot_collision">
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>1.0</mu2>
          </ode>
        </friction>
        <contact>
          <ode>
            <kp>1000000.0</kp>
            <kd>100.0</kd>
          </ode>
        </contact>
      </surface>
    </gazebo> -->
    <gazebo reference="${prefix}_foot">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>

    <gazebo>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>${prefix}_hip_joint</joint_name>
        <!-- <p_gain>0.0</p_gain> -->
        <p_gain>20.0</p_gain> <!-- default: 100.0 -->
        <i_gain>0.1</i_gain>
        <d_gain>1.0</d_gain>
        <i_max>10.0</i_max>
        <i_min>-10.0</i_min>
      </plugin>
    </gazebo>

    <gazebo>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>${prefix}_thigh_joint</joint_name>
        <!-- <p_gain>0.0</p_gain> -->
        <p_gain>70.0</p_gain> <!-- default: 150.0 -->
        <i_gain>0.1</i_gain>
        <d_gain>2.0</d_gain>
        <i_max>15.0</i_max>
        <i_min>-15.0</i_min>
      </plugin>
    </gazebo>

    <gazebo>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>${prefix}_calf_joint</joint_name>
        <!-- <p_gain>0.0</p_gain> -->
        <p_gain>70.0</p_gain> <!-- default: 150.0 -->
        <i_gain>0.1</i_gain>
        <d_gain>2.0</d_gain>
        <i_max>15.0</i_max>
        <i_min>-15.0</i_min>
      </plugin>
    </gazebo>

  </xacro:macro> </robot>