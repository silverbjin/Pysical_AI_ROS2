<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="two_dof_arm">

  <xacro:property name="base_radius" value="0.1"/>
  <xacro:property name="base_height" value="0.1"/>
  <xacro:property name="link_len" value="0.5"/>
  <xacro:property name="link_width" value="0.05"/>
  <xacro:property name="link_mass" value="1.0"/>

  <xacro:macro name="box_inertia" params="m w h d">
    <inertial>
      <origin xyz="0 0 ${h/2}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (h*h + d*d)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12) * (w*w + h*h)}" iyz="0.0"
               izz="${(m/12) * (w*w + d*d)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 ${h/2}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12) * (3*r*r + h*h)}" iyz="0.0"
               izz="${(m/2) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="arm_link_macro" params="name color_name r g b">
    <link name="${name}">
      <visual>
        <geometry>
          <box size="${link_width} ${link_width} ${link_len}"/>
        </geometry>
        <origin xyz="0 0 ${link_len/2}" rpy="0 0 0"/>
        <material name="${color_name}">
          <color rgba="${r} ${g} ${b} 1"/>
        </material>
      </visual>
      
      <collision>
        <geometry>
          <box size="${link_width} ${link_width} ${link_len}"/>
        </geometry>
        <origin xyz="0 0 ${link_len/2}" rpy="0 0 0"/>
      </collision>

      <xacro:box_inertia m="${link_mass}" w="${link_width}" h="${link_len}" d="${link_width}"/>
    </link>
  </xacro:macro>

  <!-- trouble shooting: Dummy Link 및 가상 고정 장치 추가-->
  <!-- <link name="world"/>
  <joint name="world_to_base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint> -->

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="${base_height}" radius="${base_radius}"/>
      </geometry>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <material name="gray"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder length="${base_height}" radius="${base_radius}"/></geometry>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
    </collision>
    <xacro:cylinder_inertia m="10.0" r="${base_radius}" h="${base_height}"/>
  </link>

  <xacro:arm_link_macro name="link1" color_name="orange" r="1" g="0.6" b="0"/>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
  </joint>

  <xacro:arm_link_macro name="link2" color_name="yellow" r="1" g="1" b="0"/>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 ${link_len}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/>
  </joint>

  <!-- 3.2 정적 URDF와 TF 체인을 일치시키는 고정 말단 좌표계 -->
  <joint name="joint_ee" type="fixed">
    <parent link="link2"/>
    <child link="end_effector_link"/>
    <origin xyz="0 0 ${link_len}" rpy="0 0 0"/>
  </joint>
  <link name="end_effector_link">
    <visual><geometry><sphere radius="0.02"/></geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
    <collision><geometry><sphere radius="0.02"/></geometry></collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0000016" ixy="0" ixz="0" iyy="0.0000016" iyz="0" izz="0.0000016"/>
    </inertial>
  </link>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <update_rate>1000</update_rate> 
      <joint_name>joint1</joint_name>
      <joint_name>joint2</joint_name>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>joint1</joint_name>
      <topic>/model/my_robot/joint1/cmd_pos</topic>      
      
      <p_gain>1000</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>10.0</d_gain>
      <i_max>1</i_max>
      <i_min>-1</i_min>
      <cmd_max>1000</cmd_max>
      <cmd_min>-1000</cmd_min>
      
      <initial_position>0.0</initial_position>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>joint2</joint_name>
      <topic>/model/my_robot/joint2/cmd_pos</topic>
            
      <p_gain>500</p_gain> 
      <i_gain>0.1</i_gain>
      <d_gain>5.0</d_gain>
      <i_max>5.0</i_max>
      <i_min>-5.0</i_min>
      <cmd_max>100.0</cmd_max>
      <cmd_min>-100.0</cmd_min>

      <initial_position>0.0</initial_position>
    </plugin>
  </gazebo>

</robot>

