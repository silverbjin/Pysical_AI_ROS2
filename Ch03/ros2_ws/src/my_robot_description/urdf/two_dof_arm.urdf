<?xml version="1.0"?>
<robot name="two_dof_arm">

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.1"/> </geometry>
      <origin xyz="0 0 0.05" rpy="0 0 0"/> <material name="gray">
        <color rgba="0.2 0.2 0.2 1"/> </material>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.1"/>
      </geometry>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </collision>

    <inertial>
      <mass value="10.0"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <inertia ixx="0.0333333333" ixy="0.0" ixz="0.0" iyy="0.0333333333" iyz="0.0" izz="0.05"/>
    </inertial>
  </link>
  
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="100.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="link1">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.5"/> 
        <!-- *.stl files -->
        <!-- <mesh filename="package://my_robot_description/meshes/link_1.stl" scale="0.01 0.01 0.01"/> -->
        <!-- <mesh filename="/home/jinho/Pysical_AI_book/Ch03/ros2_ws/src/my_robot_description/meshes/link_1.stl" scale="0.008 0.008 0.008"/> -->
      </geometry>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <!-- origin for *.stl files -->
      <!-- <origin xyz="0 0 0" rpy="0 1.5708 0"/> -->
      <material name="orange">
        <color rgba="1.0 0.5 0.0 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <!-- <box size="0.05 0.05 0.5"/> -->
        <cylinder length="0.5" radius="0.05"/>
      </geometry>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
    </collision>

    <inertial>
      <mass value="1.0"/> <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.0004"/>
    </inertial>
  </link>

    <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="100.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="link2">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.5"/>
      </geometry>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.05 0.05 0.5"/>
      </geometry>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.0004"/>
    </inertial>
  </link>

  <joint name="joint_ee" type="fixed">
    <parent link="link2"/>
    <child link="end_effector_link"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
  </joint>

  <link name="end_effector_link">
    <visual>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0000016" ixy="0.0" ixz="0.0" iyy="0.0000016" iyz="0.0" izz="0.0000016"/>
    </inertial>
  </link>

</robot>
