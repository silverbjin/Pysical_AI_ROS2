Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Background Color: 40; 40; 40
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Marker
      Name: Target observation (read-only)
      Enabled: true
      Marker Topic:
        Value: /ch15/visualization/target
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Marker
      Name: Mission status (read-only)
      Enabled: true
      Marker Topic:
        Value: /ch15/visualization/status
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/TF
      Name: TF (enable only if producer exists)
      Enabled: false
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel (optional)
      Enabled: false
    - Class: rviz_default_plugins/LaserScan
      Name: Scan (optional)
      Enabled: false
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Path
      Name: Path (optional)
      Enabled: false
      Topic:
        Value: /plan
    - Class: rviz_default_plugins/Map
      Name: Local costmap (optional)
      Enabled: false
      Topic:
        Value: /local_costmap/costmap
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4
      Pitch: 0.65
      Yaw: 0.75
      Focal Point:
        X: 0
        Y: 0
        Z: 0.6
  Enabled: true
Window Geometry:
  Width: 1200
  Height: 800
