Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Background Color: 25; 28; 35
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Marker
      Name: Target observation (read-only)
      Enabled: true
      Marker Topic:
        Value: /ch15/visualization/target
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Marker
      Name: Mission status (read-only)
      Enabled: true
      Marker Topic:
        Value: /ch15/visualization/status
        Reliability Policy: Reliable
        Durability Policy: Volatile
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4
      Pitch: 0.65
      Yaw: 0.75
      Focal Point:
        X: 0
        Y: 0
        Z: 0.6
  Enabled: true
Window Geometry:
  Width: 1200
  Height: 800
