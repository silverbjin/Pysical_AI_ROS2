<launch>
  <arg name="mode" default="mock"/>
  <arg name="fixed_frame" default="map"/>
  <arg name="physical_mission_id" default="cube_lab"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="gui" default="false"/>
  <arg name="view" default="presentation"/>
  <node pkg="ch15_visualization" exec="mission_marker_node" name="ch15_mission_marker" output="screen">
    <param name="mode" value="$(var mode)"/>
    <param name="fixed_frame" value="$(var fixed_frame)"/>
    <param name="physical_mission_id" value="$(var physical_mission_id)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
  <node if="$(var gui)" pkg="rviz2" exec="rviz2" name="ch15_rviz" args="-d $(find-pkg-share ch15_visualization)/rviz/$(var view).rviz" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
