<?xml version="1.0"?>
<robot name="joint_dynamics_example">
  <link name="base"/>
  <link name="link"><inertial><origin xyz="0 0 0"/><mass value="1"/><inertia ixx="1" iyy="1" izz="1" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <joint name="joint" type="revolute"><parent link="base"/><child link="link"/><axis xyz="0 0 1"/><limit lower="-2" upper="2" effort="60" velocity="20"/><dynamics damping=".5" friction=".1"/></joint>
</robot>
