<mujoco model="ch15_joint_lab">
  <compiler angle="radian"/>
  <option timestep=".005" gravity="0 0 0" integrator="Euler"/>
  <worldbody>
    <body name="hinged_link" pos="0 0 0">
      <inertial pos="0 0 0" mass="1" diaginertia="1 1 1"/>
      <joint name="joint" type="hinge" axis="0 0 1" range="-2 2" limited="true" damping=".5" frictionloss=".1" armature="0"/>
      <geom name="display" type="box" pos=".25 0 0" size=".25 .03 .03" mass="0" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
  <actuator><motor name="motor" joint="joint" gear="1" ctrllimited="true" ctrlrange="-60 60"/></actuator>
</mujoco>
