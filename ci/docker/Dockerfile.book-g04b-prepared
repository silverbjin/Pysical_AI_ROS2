# Prepared, non-default G04B runtime. Build once and pin the published digest.
# DO NOT switch actual Gazebo L2 to this image until CI parity is verified.
FROM ghcr.io/silverbjin/pysical-ai-book-gazebo@sha256:8288028a25df2dee0f8a4980231b0b9594bfd1048cdab9fc8ac49298e079e82f
USER root
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
RUN test "$(. /etc/os-release; printf '%s' "$VERSION_CODENAME")" = noble && \
    if ! apt-cache show libgz-sim8-dev >/dev/null 2>&1; then \
      curl -fsSL https://packages.osrfoundation.org/gazebo.gpg -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg && \
      printf 'deb [arch=amd64 signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] https://packages.osrfoundation.org/gazebo/ubuntu-stable noble main\n' \
        > /etc/apt/sources.list.d/gazebo-stable.list; \
    fi && \
    apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      ros-jazzy-moveit-configs-utils \
      ros-jazzy-moveit-planners-ompl \
      ros-jazzy-moveit-simple-controller-manager \
      ros-jazzy-moveit-kinematics \
      ros-jazzy-moveit-ros-move-group \
      ros-jazzy-moveit-msgs \
      ros-jazzy-gz-ros2-control \
      ros-jazzy-controller-manager \
      ros-jazzy-ros2controlcli \
      ros-jazzy-joint-trajectory-controller \
      ros-jazzy-joint-state-broadcaster \
      ros-jazzy-ros2-control \
      ros-jazzy-robot-state-publisher \
      ros-jazzy-xacro \
      ros-jazzy-control-msgs \
      libgz-sim8-dev libgz-plugin2-dev cmake g++ pkg-config && \
    rm -rf /var/lib/apt/lists/*
COPY ci/docker/check_book_g04b_prepared_runtime.sh /usr/local/bin/check_book_g04b_prepared_runtime.sh
RUN chmod 0755 /usr/local/bin/check_book_g04b_prepared_runtime.sh && \
    /usr/local/bin/check_book_g04b_prepared_runtime.sh
